{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IG Trader Control Center reviewed project status",
  "description": "Reviewed governance and technical evidence for the read-only dashboard. This file cannot grant execution authority.",
  "type": "object",
  "required": ["schema_version", "project_summary", "gates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "project_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_phase_gate_id", "current_phase", "current_status", "current_blocker", "next_action", "execution_mode", "broker_order_authority", "demo_execution", "live_execution", "real_database_state", "real_database_governance", "last_verified_at"],
      "properties": {
        "current_phase_gate_id": {"type": "string", "minLength": 1},
        "current_phase": {"type": "string", "minLength": 1},
        "current_status": {"$ref": "#/$defs/status"},
        "current_blocker": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "execution_mode": {"enum": ["NO_EXECUTION", "SHADOW_DEMO", "DEMO_EXECUTION", "LIVE_EXECUTION"]},
        "broker_order_authority": {"const": "OFF"},
        "demo_execution": {"$ref": "#/$defs/status"},
        "live_execution": {"$ref": "#/$defs/status"},
        "real_database_state": {"$ref": "#/$defs/status"},
        "real_database_governance": {"const": "RECOVERY_HOLD"},
        "last_verified_at": {"type": "string", "format": "date-time"}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "display_name", "group", "plain_english_description", "governance_status", "technical_status", "weight", "owner", "completed_sha", "related_pr", "blocker", "next_action", "evidence", "last_verified_at"],
        "additionalProperties": false,
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "group": {"enum": ["FOUNDATION", "SHADOW", "DEMO", "LIVE", "ENHANCEMENTS"]},
          "plain_english_description": {"type": "string", "minLength": 1},
          "governance_status": {"$ref": "#/$defs/status"},
          "technical_status": {"$ref": "#/$defs/status"},
          "weight": {"type": "integer", "minimum": 0},
          "owner": {"type": "string", "minLength": 1},
          "completed_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
          "related_pr": {"type": ["string", "null"]},
          "blocker": {"type": ["string", "null"]},
          "next_action": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "last_verified_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "$defs": {"status": {"enum": ["PASS", "PASS_WITH_KNOWN_GAP", "ENGINEERING_CLOSED", "IN_PROGRESS", "HOLD", "BLOCKED", "NOT_STARTED", "DISABLED", "NOT_AUTHORIZED", "UNKNOWN"]}}
}
