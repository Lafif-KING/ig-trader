# syntax=docker/dockerfile:1.7
ARG PYTHON_IMAGE=python:3.13.14-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64

FROM ${PYTHON_IMAGE} AS builder

ARG POETRY_VERSION=2.4.1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true
WORKDIR /app

RUN python -m pip install "poetry==${POETRY_VERSION}"
COPY pyproject.toml poetry.lock README.md ./
RUN poetry sync --only main --no-root --no-ansi

COPY src/ig_trader/__init__.py src/ig_trader/db_bootstrap.py src/ig_trader/execution_lease.py ./src/ig_trader/
RUN poetry install --only-root --no-ansi

FROM ${PYTHON_IMAGE} AS runtime

ARG APP_COMMIT_SHA=unknown
ARG APP_SOURCE_URL=local
ARG APP_VERSION=0.1.0
LABEL org.opencontainers.image.title="IG Trader database bootstrap jobs" \
      org.opencontainers.image.description="Finite PostgreSQL bootstrap and non-admin probe tooling" \
      org.opencontainers.image.revision="${APP_COMMIT_SHA}" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.source="${APP_SOURCE_URL}"

ENV APP_COMMIT_SHA="${APP_COMMIT_SHA}" \
    PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 10001 app && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app && \
    mkdir -p /app/src/ig_trader /app/migrations/postgresql && \
    chown -R 10001:10001 /app
WORKDIR /app
COPY --from=builder --chown=10001:10001 /app/.venv ./.venv
COPY --from=builder --chown=10001:10001 /app/src/ig_trader ./src/ig_trader
COPY --chown=10001:10001 migrations/postgresql/001_execution_state.sql migrations/postgresql/002_execution_lease_fencing.sql migrations/postgresql/003_shadow_position_state.sql ./migrations/postgresql/

USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "-m", "ig_trader.db_bootstrap"]
